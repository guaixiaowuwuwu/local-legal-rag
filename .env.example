# Copy this file to .env before running docker compose.
# Keep API keys only in backend/server environment variables. The frontend never reads them.

# Public host ports used by docker compose.
# The PostgreSQL host port defaults to 15433 to avoid conflicts with local PostgreSQL on 5432.
LEGAL_RAG_FRONTEND_PORT=5173
LEGAL_RAG_BACKEND_PORT=8080
LEGAL_RAG_POSTGRES_PORT=15433

# OpenAI-compatible API settings. A valid key is required for document indexing and Q&A.
# Basic startup and /actuator/health work without a key, but ingestion/question requests will fail fast.
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com/v1
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4o-mini
SPRING_AI_OPENAI_EMBEDDING_OPTIONS_MODEL=text-embedding-3-small

# The database schema currently creates rag_chunks.embedding as vector(1536).
# If your embedding model returns another dimension, update this value, adjust the Flyway schema,
# and rebuild the database volume before ingesting documents.
SPRING_AI_VECTORSTORE_PGVECTOR_DIMENSIONS=1536

# Chunking and retrieval defaults for the MVP demo.
LEGAL_RAG_CHUNK_SIZE=900
LEGAL_RAG_CHUNK_OVERLAP=120
LEGAL_RAG_TOP_K=5
