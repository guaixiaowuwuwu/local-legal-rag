# Copy to .env or export these variables in your shell.

LEGAL_RAG_DOCS_DIR=data/documents/formal
LEGAL_RAG_PERSIST_DIR=data/vectorstore
LEGAL_RAG_VECTOR_STORE=chroma
LEGAL_RAG_COLLECTION_NAME=legal_rag

# Embedding model. Use a local path for fully offline/private deployment.
LEGAL_RAG_EMBEDDING_MODEL=BAAI/bge-m3
LEGAL_RAG_EMBEDDING_DEVICE=cpu

# Legal-aware splitting.
LEGAL_RAG_CHUNK_SIZE=900
LEGAL_RAG_CHUNK_OVERLAP=120
LEGAL_RAG_TOP_K=5

# Use "chatglm" for real local ChatGLM generation, or "extractive" for smoke tests.
LEGAL_RAG_LLM_BACKEND=chatglm
LEGAL_RAG_LLM_MODEL=THUDM/chatglm3-6b
LEGAL_RAG_LLM_DEVICE=auto
LEGAL_RAG_MAX_NEW_TOKENS=768
LEGAL_RAG_TEMPERATURE=0.1
